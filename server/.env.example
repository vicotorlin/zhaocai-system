# ============================================
# 招采系统 - 短信 + 邮件验证码 + Supabase 配置
# 复制此文件为 .env 并填入真实值
# ============================================

PORT=3000
NODE_ENV=development

# ========== Supabase / PostgreSQL ==========
# 在 Supabase Dashboard → Settings → API 获取
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ========== 短信通道（阿里云短信） ==========
SMS_ACCESS_KEY_ID=your_access_key_id
SMS_ACCESS_KEY_SECRET=your_access_key_secret
SMS_SIGN_NAME=招采系统
SMS_TEMPLATE_CODE=SMS_123456789

# ========== 邮件通道（SMTP） ==========
# 以下以 QQ邮箱 为例：
#   1. 登录 QQ邮箱 → 设置 → 账户 → 开启 POP3/SMTP 服务
#   2. 获取授权码（不是QQ密码）
#   3. 填写下方 SMTP_USER 和 SMTP_PASS
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_authorization_code
